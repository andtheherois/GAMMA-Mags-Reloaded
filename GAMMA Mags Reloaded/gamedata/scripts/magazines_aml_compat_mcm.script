--[[
    Animated Magazine Loading - driver module
    Compatibility layer for Mags Reloaded by Priler (https://github.com/Priler)

    Detects the AML driver module (magazines_aml) and when present and enabled in
    MCM, registers it as the load driver on magazines.script.
    With it active, mag loading and unloading play AML hand animations instead of our cell overlay.
    The round data, holster and cancel logic stay owned by magazines.script.

    AML is optional.
    With the mod absent, or the MCM toggle off, or a contract mismatch,
    nothing is registered and loading runs exactly as before.
--]]

-- shown as a subcategory of the main "Magazines" MCM page
local MCM_PAGE = "magazines"
local MCM_GROUP = "aml_compat"
local DEFAULTS = { aml_enable = true, aml_anim_load_speed = 1.0, aml_anim_unload_speed = 1.0 }

local function cfg(key)
	if ui_mcm then
		return ui_mcm.get(MCM_PAGE .. "/" .. MCM_GROUP .. "/" .. key)
	end
	return DEFAULTS[key]
end

-- AML ships magazines_aml.script, the module table is our presence flag
local function aml_present()
	return magazines_aml ~= nil and magazines_aml.get_driver ~= nil
end

-- only wire it up if the AML build targets the same host seam revision
local function aml_compatible()
	return aml_present() and magazines and magazines.SEAM_CONTRACT and magazines_aml.CONTRACT == magazines.SEAM_CONTRACT
end

local warned = false
local function apply()
	if not magazines or not magazines.register_load_driver then
		return
	end

	if aml_compatible() and cfg("aml_enable") then
		magazines.register_load_driver(magazines_aml.get_driver())
	else
		magazines.clear_load_driver()
		if aml_present() and not aml_compatible() and not warned then
			warned = true
			printf(
				"RAX: AML present (contract %s) but host seam is %s - animated loading disabled",
				tostring(magazines_aml.CONTRACT),
				tostring(magazines and magazines.SEAM_CONTRACT)
			)
		end
	end

	-- push the animation speed multipliers to the driver (no-op for older AML builds)
	if aml_present() and magazines_aml.set_speed then
		magazines_aml.set_speed(cfg("aml_anim_load_speed") or 1.0, cfg("aml_anim_unload_speed") or 1.0)
	end
end

-- default direct-load key
local DIRECT_DEF_KEY = (DIK_keys and DIK_keys.DIK_LBRACKET) or 0

-- group definition for the main page to fold in as its "AML Compatibility" subcategory
-- The AML driver toggle only appears when the AML mod is installed
function get_mcm_group()
	local gr = {
		{
			id = "title",
			type = "slide",
			link = "ui_options_slider_player",
			text = "ui_mcm_magazines_compat_title",
			size = { 512, 50 },
			spacing = 20,
		},
	}

	if aml_present() then
		gr[#gr + 1] = {
			id = "aml_desc",
			type = "desc",
			text = "ui_mcm_magazines_compat_aml_desc",
			clr = { 255, 200, 200, 200 },
		}
		-- hint pins the label string id to ui_mcm_magazines_compat_aml_enable
		gr[#gr + 1] = { id = "aml_enable", type = "check", val = 1, def = true, hint = "magazines_compat_aml_enable" }
		-- animation speed multipliers for the AML load/unload hand anims (1.0 = base)
		gr[#gr + 1] = {
			id = "aml_anim_load_speed",
			type = "track",
			val = 2,
			min = 0.5,
			max = 2.0,
			step = 0.05,
			def = 1.0,
			hint = "magazines_compat_aml_anim_load_speed",
		}
		gr[#gr + 1] = {
			id = "aml_anim_unload_speed",
			type = "track",
			val = 2,
			min = 0.5,
			max = 2.0,
			step = 0.05,
			def = 1.0,
			hint = "magazines_compat_aml_anim_unload_speed",
		}
		gr[#gr + 1] = { id = "direct_line", type = "line" }
	end

	-- Direct load
	gr[#gr + 1] = {
		id = "direct_desc",
		type = "desc",
		text = "ui_mcm_magazines_compat_direct_desc",
		clr = { 255, 200, 200, 200 },
	}
	gr[#gr + 1] = {
		id = "direct_load_enable",
		type = "check",
		val = 1,
		def = true,
		hint = "magazines_compat_direct_enable",
	}
	gr[#gr + 1] = {
		id = "key_direct_load",
		type = "key_bind",
		val = 2,
		def = DIRECT_DEF_KEY,
		hint = "magazines_compat_direct_key",
	}
	gr[#gr + 1] = {
		id = "direct_load_input_mode",
		type = ui_mcm.kb_mod_radio,
		val = 2,
		def = 0,
		hint = "magazines_compat_direct_mode",
		content = { { 0, "mcm_kb_mode_press" }, { 1, "mcm_kb_mode_dtap" }, { 2, "mcm_kb_mode_hold" } },
	}
	gr[#gr + 1] = {
		id = "direct_load_order",
		type = "list",
		val = 0,
		def = "fullest",
		hint = "magazines_compat_direct_order",
		content = {
			{ "fullest", "dl_order_fullest" },
			{ "emptiest", "dl_order_emptiest" },
			{
				"marked",
				"dl_order_marked",
			},
		},
	}

	return { id = MCM_GROUP, sh = true, gr = gr }
end

function on_game_start()
	RegisterScriptCallback("actor_on_first_update", apply)
	RegisterScriptCallback("on_option_change", apply)
end
