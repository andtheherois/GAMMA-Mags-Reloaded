--[[
    Field magazine loading by Priler (https://github.com/Priler)
    Inspired by similar Tarkov SPT mod.
    t(-_-t)

    Allows for round-by-round mag load/unload keep running after the inventory is closed.

    A field load should stop the moment the hands get busy with anything else:
    drawing a weapon/knife/bolt/device, an FDDA/lizzardman hand animation, looting
    a body or container, trading, repairing, butchering, using an item, talking to
    an NPC, opening a craft bench, sprinting, etc etc etc.
--]]

local function cfg(key)
	if not magazines_mcm then
		return nil
	end
	return magazines_mcm.get_config(key)
end

-- previous-frame state for spotting a hand-held device (detector) being drawn: a
-- device does not change the weapon slot, so it needs its own rising edge
local last_detector_active = false
local last_inv_shown = false

-- weapon-slot selection keys WORK-AROUND bruh
-- A deliberate weapon draw always follows one of these.
-- an engine/other-mod auto-re-equip does not afaik.
-- So we stamp the press time and let on_changed_slot tell the two apart
-- crutch possibly, but fuck it
local wpn_draw_binds = {
	[key_bindings.kWPN_1] = true,
	[key_bindings.kWPN_2] = true,
	[key_bindings.kWPN_3] = true,
	[key_bindings.kWPN_4] = true,
	[key_bindings.kWPN_5] = true,
	[key_bindings.kWPN_6] = true,
	[key_bindings.kWPN_NEXT] = true,
}
local last_wpn_key_tg = 0

-- a slot change within this window of a weapon key is a real draw
local WPN_KEY_WINDOW = 250

-- lam2 (FDDA Redone) also runs involuntary, cosmetic animations while you just
-- stand there: an auto mask wipe in rain, a headlamp toggle, the weapon
-- lower/raise housekeeping.
-- those must NOT cancel a field load
local lam2_housekeeping_tags = {
	wpn_hide = true,
	show_items_in_hands = true,
	stop_lam2 = true,
	wait_for_seconds = true,

	-- FDDA backpack being open is the normal context for loading a mag, not a
	-- deliberate hand animation, so this lam2 action must never cancel a load
	backpack_open = true,

	-- vagina malfunction marker
	mag_loading = true,
}

local function lam2_hands_busy()
	if not (lam2 and lam2.is_running and lam2.is_running()) then
		return false
	end
	local act = lam2.get_current_action and lam2.get_current_action()
	local tag = act and act.tag
	if not tag then
		return false
	end
	return not lam2_housekeeping_tags[tag]
end

-- lam2 is running something other than our own AML load marker
local function lam2_running_other()
	if not (lam2 and lam2.is_running and lam2.is_running()) then
		return false
	end
	local act = lam2.get_current_action and lam2.get_current_action()
	return not (act and act.tag == "mag_loading")
end

local function loading_mag()
	return magazines and magazines.is_loading_mag and magazines.is_loading_mag()
end

-- diagnostics: name the cause of the cancel we are about to trigger
local function diag_arm(reason)
	if mag_field_diag and mag_field_diag.arm then
		mag_field_diag.arm(reason)
	end
end

-- tag of the lam2 action currently on the hands, for the diag reason string
local function current_lam2_tag()
	if not (lam2 and lam2.get_current_action) then
		return "none"
	end
	local act = lam2.get_current_action()
	return (act and act.tag) or "none"
end

-- our own cancels: vet the call so the host does not filter it as a foreign one
local function vetted_interrupt_magload()
	if not (magazines and magazines.do_interrupt_magload) then
		return
	end
	if magazines.vet_next_magload_cancel then
		magazines.vet_next_magload_cancel()
	end
	magazines.do_interrupt_magload()
end

local function cancel_load()
	vetted_interrupt_magload()
end

-- cancel but leave the weapon holstered (the player put it away on purpose)
local function cancel_load_holstered()
	if not loading_mag() then
		return
	end
	if magazines.forget_holster then
		magazines.forget_holster()
	end
	vetted_interrupt_magload()
end

function external_cancel_blocked()
	-- field loading off: classic behavior, let external cancels through
	if cfg("field_load_enable") == false then
		return false
	end
	return true
end

-- Cancel a running load for actions that make FDDA animate the hands (item
-- pickup/drop, using an item, butchering, opening or closing a loot/trade/repair
-- panel)
local function cancel_and_free_hands()
	if not loading_mag() then
		return
	end
	cancel_load()
end

-- true while the AML driver is playing any load animation (including the hide)
local function driver_animating()
	local d = magazines and magazines.get_load_driver and magazines.get_load_driver()
	return (d and d.is_animating and d.is_animating()) and true or false
end

-- Container/corpse looting FDDA redone queued open prevention
local loot_start_base = nil
local function wrap_loot_start()
	if loot_start_base or not (lam2 and ui_inventory and ui_inventory.start) then
		return
	end
	loot_start_base = ui_inventory.start
	ui_inventory.start = function(mode, obj)
		if mode == "loot" and loading_mag() and driver_animating() then
			return
		end
		return loot_start_base(mode, obj)
	end
end

-- Free Zoom only changes the FOV, so no cancel
local function free_zoom_active()
	return (Free_ZoomV2_mcm and Free_ZoomV2_mcm.freezooming) and true or false
end

local function free_zoom_key()
	return Free_ZoomV2_mcm and Free_ZoomV2_mcm.KEY_TOGGLE_ZOOM
end

-- per-frame checks, called from magazines.actor_on_update
function busy_hands_tick()
	if not magazines then
		return
	end

	if free_zoom_active() then
		last_detector_active = (db.actor and db.actor:active_detector()) and true or false
		local m = GetActorMenu()
		last_inv_shown = (m and m:IsShown()) or false
		return
	end
	-- a deliberate scripted hand animation: classic FDDA sets
	-- enhanced_animations.used_item; the lizzardman manager reports it through a
	-- tagged lam2 action
	local ea_used = (enhanced_animations and enhanced_animations.used_item) and true or false
	local lam2_bsy = lam2_hands_busy()
	-- the hands-busy guard exists to stop a FIELD load (inventory closed) once the
	-- player starts a real weapon/hand animation
	local menu_open = (GetActorMenu() and GetActorMenu():IsShown()) or false
	local hands_busy = ea_used or lam2_bsy
	if hands_busy and not menu_open and magazines.action_in_progress and magazines.action_in_progress() then
		diag_arm("busy_hands:" .. (ea_used and "fdda_used_item" or ("lam2:" .. current_lam2_tag())))
		if magazines.do_interrupt then
			magazines.do_interrupt()
		end
	end

	-- you cannot top up a mag while sprinting
	if IsMoveState("mcSprint") then
		diag_arm("sprint")
		cancel_load()
	end

	-- a device (detector, ...) drawn mid-load
	local m = GetActorMenu()
	local inv = (m and m:IsShown()) or false
	local det_now = (db.actor and db.actor:active_detector()) and true or false

	-- a detector we hid for this load can be re-shown by engine housekeeping
	local det_holstered = magazines.is_detector_holstered and magazines.is_detector_holstered()
	if det_now and not last_detector_active and not inv and not last_inv_shown and not det_holstered then
		-- if a player deliberately pulled a device
		diag_arm("detector_draw")
		cancel_load_holstered()
	end
	last_detector_active = det_now
	last_inv_shown = inv
end

-- Drawing a weapon/knife/bolt is a real slot change and should stop the load.
-- BUT the engine and FDDA also fire slot changes that are NOT a deliberate draw:
-- the inventory-close re-draw of the weapon we holstered, and FDDA re-equipping
-- the weapon at the end of a cosmetic animation (mask wipe, headlamp, ...)
-- those must not cancel a field load :3
local function on_changed_slot(new_slot, new_obj, prev_slot, prev_obj)
	if not loading_mag() then
		return
	end
	local holstered = magazines.get_holster_slot and magazines.get_holster_slot()
	-- our own lam2 marker must not read as FDDA housekeeping here, or a deliberate
	-- draw during an animated load would be shoved back down instead of canceling
	local fdda_busy = lam2_running_other()
	local inv_open = (GetActorMenu() and GetActorMenu():IsShown()) or false
	if not (new_slot and new_slot ~= 0) then
		return
	end

	-- an animated (AML) load owns the hands for its whole run: the driver keeps the
	-- weapon holstered for its HUD anim, so a slot draw here is never a deliberate
	-- player draw
	if driver_animating() then
		if not inv_open and db.actor and db.actor:active_slot() ~= 0 then
			db.actor:activate_slot(0)
		end
		return
	end

	-- housekeeping re-equip: ignore and keep the load running
	local is_holster_redraw = holstered and new_slot == holstered
	if fdda_busy or is_holster_redraw then
		-- if we put the weapon away for this load and we are not inside the
		-- inventory UI, shove it back down so it stays holstered
		if holstered and not inv_open and db.actor and db.actor:active_slot() ~= 0 then
			db.actor:activate_slot(0)
		end
		return
	end

	-- non-animated (no AML driver) load
	local deliberate = (time_global() - last_wpn_key_tg) <= WPN_KEY_WINDOW
	if not deliberate then
		local should_be_empty = holstered or (magazines.did_start_hands_empty and magazines.did_start_hands_empty())
		if should_be_empty and not inv_open and db.actor and db.actor:active_slot() ~= 0 then
			db.actor:activate_slot(0)
		end
		return
	end

	-- a deliberate draw of a different weapon: take hands off the mag
	diag_arm("slot_change:draw_slot=" .. tostring(new_slot))
	cancel_load_holstered()
end

-- opening anything other than your own inventory busies the hands
-- Modes: 0 closed, 1 inventory, 2 trade, 3 repair, 4 loot (body or container)
local last_menu_mode = 0
local function on_mode_changed(new_mode)
	new_mode = new_mode or 0
	local prev = last_menu_mode
	last_menu_mode = new_mode

	-- entering OR leaving a trade/repair/loot panel both make FDDA play a hand
	-- animation (body-search open/close, etc.), so free the hands on either edge.
	-- A load through your own inventory (mode 1 to 0) is untouched: field load stays
	if new_mode > 1 or prev > 1 then
		diag_arm("menu_mode:" .. tostring(prev) .. "_to_" .. tostring(new_mode))
		cancel_and_free_hands()
	end
end

-- butchering or otherwise using a mutant corpse (FDDA butcher animation)
local function on_monster_use(monster, who)
	diag_arm("monster_use:butcher")
	cancel_and_free_hands()
end

-- using any item (food, drink, meds, a tool, ...): fires before the FDDA animation
local function on_item_before_use(obj, flags)
	diag_arm("item_before_use:" .. (obj and obj:section() or "?"))
	cancel_and_free_hands()
end

-- picking an item off the ground / dropping one: FDDA plays a hand animation
-- Our own round loading also fires these as ammo moves, so gate:
--  - while a menu is open (loot/inventory) our loading is shuffling ammo through
--    here, so never cancel then
--  - with no menu, only react when lam2 is running an actual FDDA animation
local function on_item_take_drop(obj)
	local m = GetActorMenu()
	if m and m:IsShown() then
		return
	end
	if lam2_running_other() then
		diag_arm("item_take_drop:lam2:" .. current_lam2_tag())
		cancel_and_free_hands()
	end
end

-- talking to or trading with an NPC: leave the weapon holstered on cancel
local function on_npc_use(npc, who)
	diag_arm("npc_use:talk_or_trade")
	cancel_load_holstered()
end

-- opening a craft/repair/upgrade workshop (registers as "UIWorkshop")
local function on_gui_show(name, path)
	if name and string.find(name, "Workshop") then
		diag_arm("gui_show:" .. tostring(name))
		cancel_and_free_hands()
	end
end

-- keys that cancel a load when field loading is OFF (classic behavior)
local cancel_binds = {
	[key_bindings.kQUIT] = true,
	[key_bindings.kINVENTORY] = true,
}

-- Field-aware cancel for an in-progress mag load/unload from a key press
-- Public so magazines.script (and mods like Ammo Check Enhanced) can delegate
--
-- returns true when it consumed the reload key so the caller stops handling it
function handle_load_cancel_key(key, bind, flags)
	if bind and wpn_draw_binds[bind] then
		last_wpn_key_tg = time_global()
	end

	if not (magazines and magazines.action_in_progress and magazines.action_in_progress()) then
		return
	end

	-- the free zoom key only changes the FOV, so no cancel
	if key and key == free_zoom_key() then
		return
	end

	-- a manual headlamp toggle or mask wipe plays a hand animation, so either stops a load in both modes
	if bind == key_bindings.kTORCH or bind == key_bindings.kCAM_ZOOM_IN then
		diag_arm("key:torch_or_zoom")
		cancel_load_holstered()
		return
	end

	-- jumping stops a careful round-by-round load (we're not in a fkn circus)
	if bind == key_bindings.kJUMP and cfg("field_jump_cancel") ~= false then
		diag_arm("key:jump")
		vetted_interrupt_magload()
		return
	end
	local m = GetActorMenu()
	local inv = (m and m:IsShown()) or false
	if cfg("field_load_enable") ~= false then
		-- field loading keeps a load alive after the inventory closes, so the
		-- inventory-toggle and quit keys must NOT cancel it
		if not inv and bind == key_bindings.kWPN_RELOAD then
			diag_arm("key:wpn_reload")
			vetted_interrupt_magload()
			if flags then
				flags.ret_value = false
			end
			return true
		end
	elseif cancel_binds[bind] or key == DIK_keys.DIK_LMENU then
		-- field loading off: closing the inventory or quitting cancels (classic)
		diag_arm("key:classic_close")
		vetted_interrupt_magload()
	end
end

function on_game_start()
	-- FDDA's own ui_inventory.start wrapper is installed at its file scope, which
	-- loads before this file, so we wrap on top of it here
	wrap_loot_start()

	-- the load state is owned by magazines.script
	RegisterScriptCallback("actor_on_changed_slot", on_changed_slot)
	RegisterScriptCallback("ActorMenu_on_mode_changed", on_mode_changed)
	RegisterScriptCallback("monster_on_actor_use_callback", on_monster_use)
	RegisterScriptCallback("actor_on_item_before_use", on_item_before_use)
	RegisterScriptCallback("actor_on_item_take", on_item_take_drop)
	RegisterScriptCallback("actor_on_item_drop", on_item_take_drop)
	RegisterScriptCallback("npc_on_use", on_npc_use)
	RegisterScriptCallback("GUI_on_show", on_gui_show)
end
